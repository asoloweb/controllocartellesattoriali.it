---
interface Props {
	title?: string;
}

const { title = 'Richiedi una valutazione' } = Astro.props;
---

<section class="contact_form">
	<h2 class="contact_form_title">{title}</h2>
	<p class="contact_form_intro">
		Compila il modulo: il team legale ti contatterà per una prima valutazione e, successivamente, verrà
		fissato un incontro per analizzare nel dettaglio la tua posizione debitoria e le possibili soluzioni.
	</p>

	<form class="contact_form_form" method="post">
		<label class="contact_form_field">
			<span>Email *</span>
			<input name="email" type="email" autocomplete="email" required />
		</label>

		<label class="contact_form_field">
			<span>Numero di telefono *</span>
			<input name="telefono" type="tel" autocomplete="tel" required />
		</label>

		<div class="contact_form_privacy_text">
			<p>
				Massima riservatezza garantita: i dati inviati sono trattati in modo strettamente confidenziale e
				utilizzati esclusivamente per valutare la tua richiesta.
			</p>
		</div>

		<label class="contact_form_privacy">
			<input name="privacy" type="checkbox" required />
			<span>
				Accetto la <a href="/privacy-policy">privacy policy</a>
			</span>
		</label>

		<button class="contact_form_submit MainButton" type="submit">Invia richiesta</button>
		<p class="contact_form_status" role="status" aria-live="polite"></p>
	</form>
</section>

<script type="module">
	const gtagReportConversion = (url) => {
		if (typeof window.gtag !== 'function') return false;
		const callback = () => {
			if (typeof url !== 'undefined') {
				window.location = url;
			}
		};
		window.gtag('event', 'conversion', {
			send_to: 'AW-10932709528/eZrDCM_fkKkcEJjRj90o',
			value: 1.0,
			currency: 'EUR',
			event_callback: callback,
		});
		return false;
	};

	const initPartecipaForm = () => {
		const form = document.querySelector('.contact_form_form');
		if (!(form instanceof HTMLFormElement)) return;
		if (form.dataset.submitHandlerBound === 'true') return;
		form.dataset.submitHandlerBound = 'true';

		const statusEl = form.querySelector('.contact_form_status');
		const submitButton = form.querySelector('.contact_form_submit');
		let isSubmitting = false;
		const formatRomeDateTime = () =>
			new Intl.DateTimeFormat('it-IT', {
				timeZone: 'Europe/Rome',
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
				hour: '2-digit',
				minute: '2-digit',
				second: '2-digit',
				hour12: false,
			}).format(new Date());

		const submissionFingerprint = (email, telefono) =>
			`partecipa:${email}:${telefono.replace(/\s+/g, '')}`;

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (isSubmitting) return;

			const formData = new FormData(form);
			const email = String(formData.get('email') || '').trim().toLowerCase();
			const telefono = String(formData.get('telefono') || '').trim();
			const privacy = formData.get('privacy') ? 'si' : 'no';

			if (!email || !telefono || privacy !== 'si') {
				if (statusEl) {
					statusEl.textContent = 'Compila tutti i campi obbligatori e accetta la privacy policy.';
					statusEl.dataset.state = 'error';
				}
				return;
			}

			const duplicateKey = submissionFingerprint(email, telefono);
			const lastSubmitAt = Number(sessionStorage.getItem(duplicateKey) || '0');
			if (Date.now() - lastSubmitAt < 120000) {
				if (statusEl) {
					statusEl.textContent = 'Richiesta gia inviata da poco. Attendi qualche minuto.';
					statusEl.dataset.state = 'success';
				}
				return;
			}

			isSubmitting = true;
			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = true;
			}
			if (statusEl) {
				statusEl.textContent = 'Invio in corso...';
				statusEl.dataset.state = 'loading';
			}

			try {
				const idempotencyKey = crypto.randomUUID();

				const contatto = [
					`Email: ${email}`,
					`Telefono: ${telefono}`,
					'Consenso privacy: si',
					`Data richiesta: ${formatRomeDateTime()} (Europe/Rome)`,
					`ID richiesta: ${idempotencyKey}`,
				].join('\n');

				const response = await fetch('/api/complete-partecipa', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'X-Idempotency-Key': idempotencyKey,
					},
					body: JSON.stringify({ email, telefono, privacy, contatto, idempotency_key: idempotencyKey }),
				});

				if (!response.ok) {
					let detail = '';
					try {
						const errorPayload = await response.json();
						detail = String(errorPayload?.error || errorPayload?.detail || '').trim();
					} catch {
						// no-op
					}
					throw new Error(detail || `Errore invio richiesta: ${response.status}`);
				}

				if (window.umami && typeof window.umami.track === 'function') {
					window.umami.track('partecipa_form_submit', {
						email,
						telefono,
						privacy,
						source: 'partecipa_form',
						submitted_at: new Date().toISOString(),
					});
				}

				if (typeof window.gtag === 'function') {
					window.gtag('event', 'generate_lead', {
						form_name: 'partecipa_form',
						lead_type: 'contact_request',
					});
					gtagReportConversion();
				}

				form.reset();
				sessionStorage.setItem(duplicateKey, String(Date.now()));
				if (statusEl) {
					statusEl.textContent = 'Richiesta inviata con successo. Ti contatteremo al più presto.';
					statusEl.dataset.state = 'success';
				}
			} catch (error) {
				console.error('Errore invio richiesta:', error);
				if (statusEl) {
					const message = error instanceof Error && error.message ? error.message : '';
					statusEl.textContent = message || "Errore durante l'invio. Riprova più tardi.";
					statusEl.dataset.state = 'error';
				}
			} finally {
				isSubmitting = false;
				if (submitButton instanceof HTMLButtonElement) {
					submitButton.disabled = false;
				}
			}
		});
	};

	initPartecipaForm();
</script>

<style>
	.contact_form {
		background: var(--nero);
		border-radius: 24px;
		padding: 28px;
		color: var(--bianco);
	}

	.contact_form_title {
		margin: 0 0 12px;
		font-size: 28px;
	}

	.contact_form_intro {
		margin: 0 0 18px;
		font-size: 15px;
		line-height: 1.5;
		color: #ececec;
	}

	.contact_form_form {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.contact_form_field {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 14px;
	}

	.contact_form_field input {
		border: 1px solid #d9d9d9;
		border-radius: 12px;
		padding: 12px 14px;
		font: inherit;
	}

	.contact_form_privacy_text {
		background: #171717;
		border: 1px solid #2a2a2a;
		border-radius: 12px;
		padding: 12px;
		font-size: 13px;
		line-height: 1.5;
		color: #f0f0f0;
	}

	.contact_form_privacy_text p {
		margin: 0;
	}

	.contact_form_privacy {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 4px;
		font-size: 14px;
	}

	.contact_form_privacy input {
		width: 18px;
		height: 18px;
	}

	.contact_form_privacy a {
		color: var(--primary);
		text-decoration: underline;
	}

	.contact_form_submit.MainButton {
		margin-top: 6px;
		border: 0;
		border-radius: 999px;
		min-width: 0 !important;
		width: 100%;
		height: 72px;
		font-size: 30px;
		padding: 12px 18px !important;
		background: var(--primary);
		color: var(--bianco);
		font-family: var(--font-heading);
		text-align: center;
		cursor: pointer;
		transition: transform 180ms ease, opacity 180ms ease;
	}

	.contact_form_submit:hover {
		transform: translateY(-2px);
		opacity: 0.95;
	}

	.contact_form_submit:disabled {
		opacity: 0.7;
		cursor: not-allowed;
		transform: none;
	}

	.contact_form_status {
		margin: 6px 2px 0;
		font-size: 14px;
		min-height: 20px;
	}

	.contact_form_status[data-state='success'] {
		color: #53d77d;
	}

	.contact_form_status[data-state='error'] {
		color: #ff8f8f;
	}

	.contact_form_status[data-state='loading'] {
		color: #d7d7d7;
	}

	@media (max-width: 640px) {
		.contact_form_submit.MainButton {
			height: 58px;
			font-size: 22px;
		}
	}
</style>
