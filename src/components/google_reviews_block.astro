---
interface Props {
	titolo?: string;
	sottotitolo?: string;
	// Retained for compatibility with existing CMS blocks and page callers.
	google_place_id?: string;
	google_business_query?: string;
	numero_recensioni?: number;
	min_rating?: number;
	cta_label?: string;
	cta_href?: string;
}

const { titolo = 'Recensioni Google', sottotitolo = '' } = Astro.props;
---

<section class="google_reviews_block">
	<div class="google_reviews_inner">
		{titolo && <h2 class="google_reviews_title">{titolo}</h2>}
		{sottotitolo && <p class="google_reviews_subtitle">{sottotitolo}</p>}
		<div class="sk-ww-google-reviews" data-embed-id="25722287"></div>
		<script is:inline src="https://widgets.sociablekit.com/google-reviews/widget.js" defer></script>
	</div>
</section>

<style>
	.google_reviews_block {
		margin: 40px 0;
	}

	.google_reviews_inner {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 30px;
		border-radius: 20px;
		background: #fff;
		min-width: 0;
	}

	.google_reviews_title {
		margin: 0 0 20px;
		font-size: 60px;
		line-height: 1.1;
	}

	.google_reviews_subtitle {
		margin: 8px 0 20px;
		font-size: 18px;
		line-height: 1.5;
	}

	.sk-ww-google-reviews {
		width: 100%;
		min-width: 0;
	}

	@media (max-width: 768px) {
		.google_reviews_inner {
			padding: 20px;
		}

		.google_reviews_title {
			font-size: 30px;
		}
	}
</style>
